# copie para .env antes de subir a aplicacao: cp .env.example .env
# os valores abaixo ja funcionam com o docker-compose da raiz

NODE_ENV=development
PORT=3000

# origem liberada no cors, e onde o vite serve o front
CORS_ORIGIN=http://localhost:5173

DATABASE_URL="postgresql://kpmg:kpmg@localhost:5432/kpmg?schema=public"

# smtp do mailpit. sem usuario e senha porque ele aceita qualquer coisa em dev.
# para um smtp real, preencha MAIL_USER e MAIL_PASSWORD e ajuste host, porta e MAIL_SECURE
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Cadastro de Empresas <nao-responda@brunotransportes.local>"

# grupo que recebe o aviso de empresa nova, separado por virgula
MAIL_NOTIFICATION_RECIPIENTS=cadastro@brunotransportes.local,financeiro@brunotransportes.local
